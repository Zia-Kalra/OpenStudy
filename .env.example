
# Database connection
DB_URL=jdbc:mysql://your-aiven-host:your-port/openstudy_db?sslMode=VERIFY_IDENTITY
DB_USERNAME=your_database_username
DB_PASSWORD=replace_with_your_password

# Aiven SSL truststore
DB_TRUSTSTORE_PASSWORD=replace_with_your_truststore_password
DB_TRUSTSTORE_URL=file:/path/to/aiven-truststore.jks

# Optional SMTP for password-reset emails. Leave blank to run without email.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=replace_with_your_smtp_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true


# Groq AI. Never commit a real key.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
OPENSTUDY_AI_PROVIDER=groq
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# R statistics
# Absolute path to Rscript if it is not on PATH, e.g. C:\Program Files\R\R-4.4.1\bin\Rscript.exe
RSCRIPT_PATH=Rscript
# Only needed if the R/ folder is not found automatically (tries ./R and ../R)
ANALYTICS_R_SCRIPT_DIR=R
ANALYTICS_R_TIMEOUT_SECONDS=30
# DEVELOPMENT ONLY (before login exists): act as this student/teacher. Keep false in production.
ANALYTICS_DEV_IDENTITY=false
ANALYTICS_DEV_STUDENT_ID=0
ANALYTICS_DEV_TEACHER_ID=0
