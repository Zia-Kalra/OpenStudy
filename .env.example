
# Database connection
DB_URL=jdbc:mysql://your-aiven-host:your-port/openstudy_db?sslMode=VERIFY_IDENTITY
DB_USERNAME=your_database_username
DB_PASSWORD=replace_with_your_password

# Aiven SSL truststore
DB_TRUSTSTORE_PASSWORD=replace_with_your_truststore_password
DB_TRUSTSTORE_URL=file:/path/to/aiven-truststore.jks

# Optional SMTP for password-reset emails. Leave blank to run without email.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=replace_with_your_smtp_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Shared Gemini AI (Member 5). Never commit a real key.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
git add .env.example
