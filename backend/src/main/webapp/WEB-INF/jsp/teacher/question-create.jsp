<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create MCQ | OpenStudy</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/teacher-dashboard.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/question-bank.css"></head><body class="teacher-shell"><div class="layout"><jsp:include page="fragments/sidebar.jsp"/><div class="layout-main"><jsp:include page="fragments/navbar.jsp"/><main class="content qb-page"><a class="qb-back" href="${pageContext.request.contextPath}/teacher/question-bank">â† Question Bank</a><h1 id="formTitle">Create MCQ Question</h1><p>Add a reusable multiple choice question to your question bank.</p><form id="questionForm" class="qb-card qb-form"><label class="qb-field wide">Question Text *<textarea id="questionText" maxlength="4000" required placeholder="Enter your question hereâ€¦"></textarea></label><div class="qb-grid"><label class="qb-field">Subject *<select id="subject" required><option value="">Loading subjectsâ€¦</option></select></label><label class="qb-field">Topic<input id="topic" maxlength="200" placeholder="e.g. Exception Handling"></label><label class="qb-field">Difficulty<select id="difficulty"><option value="EASY">Easy</option><option value="MEDIUM" selected>Medium</option><option value="HARD">Hard</option></select></label><label class="qb-field">Marks *<input id="points" type="number" min="0.01" max="999" step="0.01" value="1" required></label></div><p class="qb-muted">Source: Manual</p><input type="hidden" id="questionType" value="SINGLE_CHOICE"><section><h2>Options <span id="optionCount"></span></h2><p class="qb-muted">Select the radio button beside the correct answer.</p><div id="options"></div><button type="button" class="qb-light" id="addOption">ï¼‹ Add option</button></section><p id="formMessage" role="status"></p><div class="qb-actions"><a class="qb-light" href="${pageContext.request.contextPath}/teacher/question-bank">Cancel</a><button type="submit" class="qb-button" id="saveQuestion">Save Question</button></div></form></main></div></div><script>window.OPENSTUDY_CONTEXT='${fn:escapeXml(pageContext.request.contextPath)}';window.QUESTION_ID='${param.id}';</script><script src="${pageContext.request.contextPath}/js/question-create.js" defer></script></body></html>

