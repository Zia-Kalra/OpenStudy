<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<section class="ta-panel" aria-labelledby="assessmentHeading">
    <div class="ta-panel-heading"><div><p class="ta-kicker">COMPARE THE WORK</p><h2 id="assessmentHeading">Assessment Analytics</h2><p>Compare normalized results, participation, and the work still awaiting a grade.</p></div><span class="ta-label"><c:out value="${fn:length(analytics.assessments)}"/> assessments in view</span></div>
    <div class="ta-comparison-strip"><div><span>Quiz average</span><strong><c:out value="${analytics.overview.getQuizDisplay()}"/></strong></div><div><span>Assignment average</span><strong><c:out value="${analytics.overview.getAssignmentDisplay()}"/></strong></div><div><span>Overall submission rate</span><strong><c:out value="${analytics.overview.getSubmissionDisplay()}"/></strong></div></div>
    <div class="ta-table-scroll"><table class="ta-table"><caption>Assessment comparisons across assigned subjects</caption><thead><tr><th scope="col">Assessment</th><th scope="col">${empty analytics.classes ? 'Subject' : 'Class / subject'}</th><th scope="col">Type</th><th scope="col">Date</th><th scope="col">Average</th><th scope="col">Graded</th><th scope="col">Submission rate</th></tr></thead><tbody>
        <c:forEach var="assessment" items="${analytics.assessments}"><tr><th scope="row"><c:out value="${assessment.title}"/></th><td><c:if test="${not empty analytics.classes}"><c:out value="${assessment.getClassDisplay()}"/></c:if><span class="ta-cell-subtitle"><c:out value="${assessment.subject}"/></span></td><td><span class="ta-type ta-${fn:escapeXml(assessment.type)}"><c:out value="${assessment.type}"/></span></td><td><c:out value="${assessment.date}"/></td><td><b><c:out value="${assessment.getAverageDisplay()}"/></b></td><td><c:out value="${assessment.graded}"/> / <c:out value="${assessment.expected}"/></td><td><div class="ta-bar-label"><b><c:out value="${assessment.getSubmissionDisplay()}"/></b><span><c:out value="${assessment.submitted}"/> / <c:out value="${assessment.expected}"/></span></div><div class="ta-mini-track"><span style="width:${assessment.submissionRate}%"></span></div></td></tr></c:forEach>
    </tbody></table></div>
    <c:if test="${empty analytics.assessments}"><p class="ta-empty">No published assessments are available for your selected subjects.</p></c:if>
</section>
<div class="ta-two-column">
    <section class="ta-panel"><div class="ta-panel-heading"><div><h3>Subject comparison</h3><p>Quizzes and assignments share a normalized percentage scale.</p></div></div><c:forEach var="subject" items="${analytics.subjectComparison}"><div class="ta-student-subject"><div class="ta-bar-label"><strong><c:out value="${subject.label}"/></strong><b><c:out value="${subject.getAverageDisplay()}"/></b></div><div class="ta-track"><span style="width:${subject.getAverage()}%"></span></div><p>Quiz <c:out value="${subject.getQuizDisplay()}"/> · Assignment <c:out value="${subject.getAssignmentDisplay()}"/></p></div></c:forEach><c:if test="${empty analytics.subjectComparison}"><p class="ta-empty">No graded subject comparison is available.</p></c:if></section>
    <section class="ta-panel ta-insight"><p class="ta-kicker">READ THE NUMBERS IN CONTEXT</p><h3>Participation comes before comparison</h3><p>A strong average with a low submission rate may describe only part of the class. Check missing work and pending grades before comparing assessments.</p><p>Scores exclude missing and ungraded submissions. Submission rates include submitted work awaiting grading.</p></section>
</div>
<section class="ta-panel" aria-labelledby="difficultyHeading"><div class="ta-panel-heading"><div><h3 id="difficultyHeading">Question difficulty</h3><p>Compare author-set difficulty with the proportion of correct responses. Counts use the latest submitted quiz attempt and final awarded points. Ungraded responses are excluded.</p></div></div>
    <div class="ta-table-scroll"><table class="ta-table"><caption>Quiz question response rates</caption><thead><tr><th scope="col">Assessment</th><th scope="col">Question</th><th scope="col">Difficulty</th><th scope="col">Correct / graded responses</th><th scope="col">Correct response rate</th></tr></thead><tbody><c:forEach var="question" items="${analytics.questions}"><tr><th scope="row"><c:out value="${question.assessment}"/></th><td><c:out value="${question.label}"/></td><td><span class="ta-label"><c:out value="${question.difficulty}"/></span></td><td><c:out value="${question.correct}"/> / <c:out value="${question.answered}"/></td><td><b><c:out value="${question.getRateDisplay()}"/></b><div class="ta-mini-track"><span style="width:${question.correctRate}%"></span></div></td></tr></c:forEach></tbody></table></div>
    <c:if test="${empty analytics.questions}"><p class="ta-empty">Question-level results will appear when quiz data is available.</p></c:if>
</section>
