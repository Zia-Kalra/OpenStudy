<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<section class="ta-panel" aria-labelledby="explorerHeading">
    <div class="ta-panel-heading"><div><p class="ta-kicker">FROM CLASS TO STUDENT</p><h2 id="explorerHeading">Student Performance Explorer</h2><p>Select a student to inspect subject scores, submitted work, and feedback.</p></div><span class="ta-label"><c:out value="${fn:length(analytics.students)}"/> of <c:out value="${analytics.overview.totalStudents}"/> students shown</span></div>
    <c:url value="/teacher/analytics/students" var="searchAction"/>
    <c:if test="${analytics.overview.totalStudents > 0}">
    <form class="ta-search-form" method="get" action="${fn:escapeXml(searchAction)}">
        <input type="hidden" name="classId" value="${fn:escapeXml(analytics.query.classId)}"><input type="hidden" name="subjectId" value="${fn:escapeXml(analytics.query.subjectId)}">
        <label class="ta-search">Search students<input type="search" name="search" maxlength="100" placeholder="${analytics.demo ? 'Name or student number' : 'Name or user ID'}" value="${fn:escapeXml(analytics.query.search)}"></label>
        <label>Performance<select name="band"><option value="ALL">All performance bands</option><option value="STRONG" ${analytics.query.band == 'STRONG' ? 'selected' : ''}>Strong · 80%+</option><option value="ON_TRACK" ${analytics.query.band == 'ON_TRACK' ? 'selected' : ''}>On track · 65–79%</option><option value="DEVELOPING" ${analytics.query.band == 'DEVELOPING' ? 'selected' : ''}>Developing · 50–64%</option><option value="NEEDS_ATTENTION" ${analytics.query.band == 'NEEDS_ATTENTION' ? 'selected' : ''}>Needs attention · below 50%</option><option value="NOT_GRADED" ${analytics.query.band == 'NOT_GRADED' ? 'selected' : ''}>Not graded</option></select></label>
        <label>Sort by<select name="sort"><option value="SCORE" ${analytics.query.sort == 'SCORE' ? 'selected' : ''}>Highest average</option><option value="NAME" ${analytics.query.sort == 'NAME' ? 'selected' : ''}>Student name</option><option value="SUBMISSION" ${analytics.query.sort == 'SUBMISSION' ? 'selected' : ''}>Submission rate</option></select></label>
        <button type="submit" class="ta-button">Find students</button>
        <c:url value="/teacher/analytics/students" var="resetStudentsUrl"><c:param name="subjectId" value="${analytics.query.subjectId}"/><c:if test="${not empty analytics.classes}"><c:param name="classId" value="${analytics.query.classId}"/></c:if></c:url>
        <a class="ta-reset" href="${fn:escapeXml(resetStudentsUrl)}">Clear student filters</a>
    </form>
    </c:if>
    <div class="ta-table-scroll"><table class="ta-table"><caption>Enrolled students and performance in the selected subject scope</caption><thead><tr><th scope="col">Student</th><c:if test="${not empty analytics.classes}"><th scope="col">Class</th></c:if><th scope="col">Average</th><th scope="col">Quiz</th><th scope="col">Assignment</th><th scope="col">Submitted</th><th scope="col">Performance</th><th scope="col">Details</th></tr></thead><tbody>
        <c:forEach var="row" items="${analytics.students}">
            <c:url value="/teacher/analytics/students/${row.student.id}" var="studentUrl"><c:param name="classId" value="${analytics.query.classId}"/><c:param name="subjectId" value="${analytics.query.subjectId}"/><c:param name="search" value="${analytics.query.search}"/><c:param name="band" value="${analytics.query.band}"/><c:param name="sort" value="${analytics.query.sort}"/></c:url>
            <tr class="${analytics.selectedStudent.summary.student.id == row.student.id ? 'ta-selected-row' : ''}"><th scope="row"><strong><c:out value="${row.student.name}"/></strong><span class="ta-cell-subtitle"><c:out value="${row.student.rollNumber}"/></span></th><c:if test="${not empty analytics.classes}"><td><c:out value="${row.student.getClassDisplay()}"/></td></c:if><td><b><c:out value="${row.getAverageDisplay()}"/></b><div class="ta-mini-track"><span style="width:${row.getAverage()}%"></span></div></td><td><c:out value="${row.getQuizDisplay()}"/></td><td><c:out value="${row.getAssignmentDisplay()}"/></td><td><c:out value="${row.getSubmissionDisplay()}"/></td><td><span class="ta-status ta-${fn:escapeXml(row.band)}"><c:out value="${row.bandLabel}"/></span></td><td><a class="ta-text-link" href="${fn:escapeXml(studentUrl)}" aria-label="View ${fn:escapeXml(row.student.name)}">View →</a></td></tr>
        </c:forEach>
    </tbody></table></div>
    <c:if test="${empty analytics.students}"><div class="ta-empty"><h3>${analytics.overview.totalStudents == 0 ? 'No enrolled students are available' : 'No students match these filters'}</h3><p>Only students with an active enrollment in your assigned subjects are included. Search and performance filters narrow this roster.</p></div></c:if>
</section>
<c:if test="${not empty analytics.selectedStudent}">
    <c:set var="detail" value="${analytics.selectedStudent}"/>
    <section class="ta-panel ta-student-detail" aria-labelledby="studentHeading">
        <div class="ta-panel-heading"><div><p class="ta-kicker">STUDENT DETAIL</p><h2 id="studentHeading"><c:out value="${detail.summary.student.name}"/></h2><p><c:out value="${detail.summary.student.rollNumber}"/> · <c:if test="${not empty analytics.classes}"><c:out value="${detail.summary.student.getClassDisplay()}"/></c:if> · <c:out value="${detail.summary.graded}"/> graded assessments</p></div><span class="ta-status ta-${fn:escapeXml(detail.summary.band)}"><c:out value="${detail.summary.bandLabel}"/></span></div>
        <div class="ta-detail-columns">
            <div><h3>Subject-wise scores</h3><c:forEach var="subject" items="${detail.subjects}"><div class="ta-student-subject"><div class="ta-bar-label"><strong><c:out value="${subject.label}"/></strong><b><c:out value="${subject.getAverageDisplay()}"/></b></div><div class="ta-track"><span style="width:${subject.getAverage()}%"></span></div><p>Quiz <c:out value="${subject.getQuizDisplay()}"/> · Assignment <c:out value="${subject.getAssignmentDisplay()}"/></p></div></c:forEach></div>
            <div><h3>Progress over time</h3><div class="ta-legend"><span class="ta-quiz-key">Quiz</span><span class="ta-assignment-key">Assignment</span></div><div class="ta-trend-chart ta-small-chart" role="group" aria-label="Selected student's weekly scores, with exact values beneath each pair of bars"><c:forEach var="point" items="${detail.trends}"><div class="ta-trend-group"><div class="ta-bar-pair"><div class="ta-quiz-bar" style="height:${point.getQuizHeight()}%"></div><div class="ta-assignment-bar" style="height:${point.getAssignmentHeight()}%"></div></div><strong><c:out value="${point.label}"/></strong><span><c:out value="${point.getQuizDisplay()}"/> / <c:out value="${point.getAssignmentDisplay()}"/></span></div></c:forEach></div></div>
        </div>
        <div class="ta-feedback"><h3>Feedback summary</h3><ul><c:forEach var="feedback" items="${detail.feedback}"><li><c:out value="${feedback}"/></li></c:forEach></ul><c:if test="${empty detail.feedback}"><p>No graded feedback is available yet.</p></c:if><span><c:out value="${detail.summary.missing}"/> outstanding submissions · <c:out value="${detail.summary.submitted - detail.summary.graded}"/> awaiting grading</span></div>
        <details class="ta-history" open><summary>Quiz and assignment history</summary><div class="ta-table-scroll"><table class="ta-table"><caption>Selected student's assessment history</caption><thead><tr><th scope="col">Assessment</th><th scope="col">Subject</th><th scope="col">Type</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col">Score</th><th scope="col">Feedback</th></tr></thead><tbody><c:forEach var="entry" items="${detail.history}"><tr><th scope="row"><c:out value="${entry.title}"/></th><td><c:out value="${entry.subject}"/></td><td><c:out value="${entry.type}"/></td><td><c:out value="${entry.date}"/></td><td><c:out value="${entry.status}"/></td><td><c:out value="${entry.getScoreDisplay()}"/></td><td class="ta-feedback-cell"><c:out value="${entry.feedback}"/></td></tr></c:forEach></tbody></table></div></details>
    </section>
</c:if>
